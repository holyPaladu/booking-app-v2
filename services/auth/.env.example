# PostgreSQL connection string (required)
DB_URL=postgres://postgres:postgres@localhost:5432/auth

# JWT (секрет обязателен; смени в production)
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m

# Refresh-сессии: время жизни refresh-токена в днях
REFRESH_TTL_DAYS=30

# HTTP
PORT=3000
NODE_ENV=development

# Argon2id (Bun.password)
ARGON_MEMORY=65536
ARGON_TIME_COST=3

# Outbox worker poll interval, ms (доставка верификационных писем)
OUTBOX_POLL_MS=2000

# 2FA (TOTP). TWO_FACTOR_ENC_KEY обязателен: base64 от 32 байт (AES-256) для
# шифрования TOTP-секрета в покое. Сгенерировать: openssl rand -base64 32
TWO_FACTOR_ENC_KEY=change-me-base64-of-32-bytes
TWO_FACTOR_ISSUER=BookingApp
TWO_FACTOR_WINDOW=1
RECOVERY_CODES_COUNT=10
# Время жизни challenge-токена между шагом-1 (пароль) и шагом-2 (2FA) логина
TWO_FACTOR_CHALLENGE_TTL=5m